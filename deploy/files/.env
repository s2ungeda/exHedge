# LS증권 OpenAPI 설정 (비민감 항목만)
# 👉 API 키(appkey/appsecret)와 계좌 비밀번호는 여기가 아니라
#    setup.exe 를 실행해서 Windows 자격 증명 관리자에 안전하게 저장합니다.
#    (이 파일에는 계좌번호 등 비민감 항목만 넣습니다)

# 실거래(prod) | 모의투자(mock) — 처음에는 mock 권장
LS_ENV=mock

# 계좌번호 — 파생(선물옵션) 계좌번호를 채우세요.
# (단일 계좌만 쓰면 LS_ACCOUNT_NO 한 줄만 채워도 폴백으로 동작)
LS_STOCK_ACCOUNT_NO=
LS_FUTURES_ACCOUNT_NO=
LS_ACCOUNT_NO=
LS_ACCOUNT_PRODUCT_CODE=01

# 시그널 처리 토큰 — 이 토큰과 일치하는 시그널만 처리(다른 발신처 거부). 예: Dalin / Meme
# 비워두면 모든 시그널 수락. 캡션·로그줄에 발신처가 색으로 구분됩니다.
SIGNAL_TOKEN=Dalin

# 로깅 레벨
LOG_LEVEL=INFO
